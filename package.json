{
  "name": "ok-agency-site",
  "private": true,
  "version": "1.0.0",
  "description": "Wielostronicowy serwis OK Agency publikowany pod okagency.pl.",
  "scripts": {
    "dev": "node server.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:quality": "npm run check:asset-versions && node scripts/check-site-quality.mjs && node scripts/check-diagnosis.mjs && node scripts/check-about-navigation.mjs && node scripts/check-home-hero.mjs && node scripts/check-responsive-safety.mjs && node scripts/check-global-navigation.mjs && node scripts/check-motion-system.mjs && npm run check:analytics && npm run check:ui-system && npm run check:system-exceptions",
    "check:analytics": "node --test scripts/analytics.test.mjs worker/contact.test.mjs",
    "check:consent-responsive": "node scripts/check-consent-responsive.mjs",
    "check:global-navigation-runtime": "node scripts/check-global-navigation.mjs --runtime",
    "check:global-navigation-webkit": "node scripts/check-global-navigation.mjs --runtime --webkit",
    "check:desktop-system-components": "node scripts/check-desktop-system-components.mjs",
    "check:fhd-2k-responsive": "node scripts/check-fhd-2k-responsive.mjs",
    "check:fhd-2k-responsive:webkit": "node scripts/check-fhd-2k-responsive.mjs --webkit",
    "check:system-scale": "node scripts/check-system-scale.mjs",
    "check:system-scale:diagnosis-short": "node scripts/check-system-scale.mjs --diagnosis-short-only",
    "check:system-scale:full": "node scripts/check-system-scale.mjs --full --screenshots",
    "check:system-scale:webkit": "node scripts/check-system-scale.mjs --webkit --engine-smoke",
    "audit:system-exceptions": "node scripts/audit-system-exceptions.mjs --write",
    "check:system-exceptions": "node scripts/audit-system-exceptions.mjs --check",
    "submit:indexnow": "node scripts/submit-indexnow.mjs",
    "check:asset-versions": "node scripts/sync-asset-versions.mjs --check",
    "sync:asset-versions": "node scripts/sync-asset-versions.mjs",
    "check:ui-system": "node scripts/check-ui-system.mjs",
    "build:annotation-masks": "node scripts/build-annotation-placement-masks.mjs",
    "check:annotation-energy": "node scripts/check-annotation-energy.mjs",
    "check:annotation-geometry": "node scripts/check-annotation-geometry.mjs",
    "check:scene-disclosures": "node scripts/check-scene-disclosures.mjs",
    "check:production-art-safety": "node scripts/check-production-art-safety.mjs",
    "check:pages-functions": "wrangler pages functions build functions --outfile dist/pages-worker.js",
    "check:worker": "wrangler deploy --config wrangler.contact.jsonc --dry-run --outdir dist/worker-dry-run",
    "prebuild": "npm run check:links && npm run check:quality",
    "build": "node scripts/build.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "axe-core": "^4.12.1",
    "playwright": "^1.60.0",
    "wrangler": "^4.115.0"
  }
}
