---
const steps = [
  { number: "01", title: "Poznajemy firmę" },
  { number: "02", title: "Ustalamy priorytety" },
  { number: "03", title: "Projektujemy działania" },
];
---

<ol class="process-rail">
  {
    steps.map((step) => (
      <li class="process-step" data-reveal>
        <div class="process-step__top">
          <span class="process-step__number">{step.number}</span>
          <span class="process-step__line" aria-hidden="true" />
        </div>
        <h3>{step.title}</h3>
      </li>
    ))
  }
</ol>
