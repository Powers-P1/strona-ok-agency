---
import ActionLink from "../components/ActionLink.astro";
import ProcessRail from "../components/ProcessRail.astro";
import ServiceRow from "../components/ServiceRow.astro";
import SignalMark from "../components/SignalMark.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "OK Agency — marketing online i strony internetowe dla MŚP";
const description =
  "OK Agency łączy marketing digitalowy i tworzenie stron internetowych dla małych firm i MŚP.";
---

<BaseLayout {title} {description}>
  <div id="top"></div>
  <SiteHeader />

  <main id="main-content">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__inner container">
        <div class="hero__copy" data-reveal>
          <h1 id="hero-title">Marketing, który pomaga małym firmom rosnąć online.</h1>
          <p>
            Łączymy marketing digitalowy i tworzenie stron internetowych — z myślą o potrzebach
            małych firm i MŚP.
          </p>
          <div class="hero__actions">
            <ActionLink href="#uslugi" label="Poznaj zakres współpracy" />
            <ActionLink href="#jak-dzialamy" label="Zobacz, jak działamy" variant="text" />
          </div>
        </div>
        <div class="hero__visual" data-reveal>
          <SignalMark />
        </div>
      </div>
    </section>

    <section class="services section-anchor" id="uslugi" aria-labelledby="services-title">
      <div class="container">
        <div class="services__intro" data-reveal>
          <h2 id="services-title">Dwa obszary.<br />Jeden spójny kierunek.</h2>
          <div>
            <p>Usługi skupione na tym, czego mała firma potrzebuje w internecie.</p>
            <span class="intro-signal" aria-hidden="true"></span>
          </div>
        </div>
        <div class="services__list">
          <ServiceRow
            number="01"
            title="Marketing online"
            description="Pomagamy porządkować obecność i działania marketingowe w kanałach digitalowych."
          />
          <ServiceRow
            number="02"
            title="Strony internetowe"
            description="Projektujemy i tworzymy strony, które jasno pokazują ofertę i ułatwiają odbiorcom kolejny krok."
          />
        </div>
      </div>
    </section>

    <section class="process section-anchor" id="jak-dzialamy" aria-labelledby="process-title">
      <div class="container">
        <div class="process__heading" data-reveal>
          <h2 id="process-title">Najpierw porządek,<br />potem <span>ruch.</span></h2>
          <p>Prosty proces, który pomaga utrzymać wspólny kierunek.</p>
        </div>
        <ProcessRail />
      </div>
    </section>

    <section class="audience section-anchor" id="dla-kogo" aria-labelledby="audience-title">
      <div class="audience__inner container">
        <div class="audience__type" aria-hidden="true" data-reveal>MŚP</div>
        <div class="audience__copy" data-reveal>
          <h2 id="audience-title">Dla małych firm,<br />bez nadmiaru<span>.</span></h2>
          <p>
            Łączymy marketing online i strony internetowe w jednym, czytelnym podejściu dopasowanym
            do skali MŚP.
          </p>
          <dl class="audience__facts">
            <div>
              <dt>Zakres</dt>
              <dd>Marketing online i strony internetowe</dd>
            </div>
            <div>
              <dt>Odbiorcy</dt>
              <dd>Małe firmy i MŚP</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section class="closing" aria-labelledby="closing-title">
      <div class="closing__shape" aria-hidden="true"></div>
      <div class="closing__inner container" data-reveal>
        <div class="closing__copy">
          <h2 id="closing-title">Zacznij od<br />dobrego kierunku.</h2>
          <p>Poznaj zakres usług OK Agency i wybierz obszar, od którego warto zacząć.</p>
          <ActionLink href="#uslugi" label="Zobacz zakres" variant="signal" />
        </div>
        <span class="closing__signal" aria-hidden="true"></span>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
